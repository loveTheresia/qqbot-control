# 复制为 config/.env，不要把真实值提交到 Git
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# QQ / NapCat
MASTER_UIDS=
NAPCAT_WS=ws://127.0.0.1:3001
NAPCAT_QUICK_ACCOUNT=

# 群聊 / 记忆
FOLLOWUP_WINDOW_SEC=300
GROUP_REPLY_COOLDOWN_SEC=60
GROUP_MIN_OTHERS_MSGS=2
GROUP_MAX_REPLIES_10MIN=4
AMBIENT_MODE=conservative
LULL_SEC=35
AMBIENT_THRESHOLD=0.7
AMBIENT_MAX_10MIN=2

# 工作台 / GitHub 控制面
POLICY_ENABLED=1
GH_REPO=
GH_BRANCH=main
GH_TOKEN=
GH_AUTHOR_NAME=
GH_AUTHOR_EMAIL=
